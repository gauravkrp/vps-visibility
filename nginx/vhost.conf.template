server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __REPO_DIR__/dashboard;
    index index.html;

    auth_basic "vps-visibility";
    auth_basic_user_file /etc/vps-visibility/htpasswd;

    location /data/ {
        alias __DATA_DIR__/public/;
        autoindex off;
    }
}
